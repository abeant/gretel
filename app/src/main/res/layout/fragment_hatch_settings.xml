<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitStart"
        android:src="@drawable/gretel_lockup"
        app:tint="?android:attr/textColorPrimary" />

    <com.abeant.gretel.ui.PagedColumn
        android:id="@+id/settingsPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/banner"
            style="@style/Text.Gretel.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/banner_outline"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/tap_min"
            android:padding="12dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            style="@style/Text.Gretel.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_your_app"
            app:layout_keepWithNext="true" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/appRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/section_door"
            app:rowValue="@string/door_none" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/homeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/section_home"
            app:rowValue="@string/home_status_no" />

        <TextView
            style="@style/Text.Gretel.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_opening"
            app:layout_keepWithNext="true" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/bootRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/open_on_boot"
            app:rowToggle="true" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/relaunchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/relaunch_on_close"
            app:rowToggle="true" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/timingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/section_hatch_timing"
            app:rowValue="@string/timing_normal" />

        <TextView
            style="@style/Text.Gretel.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_device"
            app:layout_keepWithNext="true" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/themeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/section_display"
            app:rowValue="@string/theme_auto" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/androidSettingsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/android_settings" />

        <TextView
            style="@style/Text.Gretel.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_help"
            app:layout_keepWithNext="true" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/getBackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/hatch_lesson_title" />

        <com.abeant.gretel.ui.SettingRow
            android:id="@+id/aboutRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowLabel="@string/about_license" />
    </com.abeant.gretel.ui.PagedColumn>

    <Button
        android:id="@+id/primaryButton"
        style="@style/Widget.Gretel.Button.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/choose_app_label" />
</LinearLayout>
