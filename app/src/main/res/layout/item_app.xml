<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/row_outline"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tap_min"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/icon_frame"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="3dp" />

    <TextView
        android:id="@+id/appLabel"
        style="@style/Text.Gretel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/row_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/selectedBadge"
        style="@style/Text.Gretel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/selected_mark"
        android:textColor="@color/row_text"
        android:visibility="gone" />
</LinearLayout>
