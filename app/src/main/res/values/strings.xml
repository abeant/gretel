    <string name="set_home_title">Set Gretel as your home app</string>
    <string name="set_home_body">Android will ask you to confirm. Once Gretel is set, using Home returns you to the app you chose.\n\nNothing is locked. You can choose another home app at any time in Android settings.</string>
