    <string name="about_title">About</string>
    <string name="about_version">Gretel %1$s (%2$d)</string>
    <string name="about_identity">Gretel is an anti-launcher for Android. Choose an app and Gretel makes it the place your device returns to.\n\nGretel does not lock your device. Home twice quickly opens its settings, Android settings let you choose another home app, and you can uninstall it like any other app.</string>
    <string name="about_privacy">Gretel collects nothing. No accounts, analytics, ads, or network access.</string>
